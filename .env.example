# ── Supabase ────────────────────────────────────────────────
# Public values — safe to ship to the browser. RLS protects the data,
# not the key. Use the project's anon (or publishable) key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ── Auth (Microsoft SSO) ────────────────────────────────────
# Comma-separated email domains permitted to sign in. Enforced in /auth/callback.
# (Not secret — VITE_ prefix so it resolves in the vinext/Vite build. Empty =
# allow any domain.)
VITE_ALLOWED_EMAIL_DOMAINS=adaca.com

# ── Email (Resend) ──────────────────────────────────────────
# Transactional app email — server-only. SSO means Supabase sends no auth mail.
RESEND_API_KEY=YOUR-RESEND-API-KEY
EMAIL_FROM=Adaca Red <ops@adaca.com>

# ── Public forms + workflow engine ──────────────────────────
# The public /d/* surface writes via the service-role key (anon has zero
# grants). Server-only; in prod set via `wrangler secret put`.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Anthropic API key for the assessment workflow. Server-only secret.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY

# Cloudflare Turnstile (public forms). Leave both unset in dev to skip the
# challenge — same convention as the Basic Auth gate.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canonical public origin for report links in cron-driven runs
# (request-driven runs derive it from the request).
PUBLIC_ORIGIN=http://localhost:3000

# Cloudflare account id for wrangler deploys (keeps deploys out of the wrong workspace)
CLOUDFLARE_ACCOUNT_ID=

# Worker Basic Auth gate (synced to Cloudflare on deploy; leave empty to disable the gate)
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
